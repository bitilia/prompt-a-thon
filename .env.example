# =====================================================================
# prompt-a-thon competition — environment configuration
# Copy to .env and fill in, or let setup.py generate one for you.
# =====================================================================

# ---------- Branding ----------
APP_NAME=prompt-a-thon
TAGLINE=AI Literacy Competition
COLLEGE_NAME=Your College
COLLEGE_URL=https://example.edu
CONTACT_EMAIL=organisers@example.edu

# Public base URL (no trailing slash). Used in emails and SSO redirects.
BASE_URL=https://competition.example.edu

# ---------- Security ----------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
# Rotating this key invalidates all sessions AND all encrypted columns.
SECRET_KEY=change-me-to-128-hex-chars-via-secrets-token-hex-64

# Set to "production" or "development".
FLASK_ENV=production

# Trust X-Forwarded-* headers from this many proxy hops (1 for Caddy/nginx).
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1

# ---------- Database ----------
DATABASE_URL=sqlite:////opt/prompt-a-thon/instance/prompt.db

# ---------- Admin bootstrap ----------
ADMIN_EMAIL=admin@example.edu

# Leave blank. If set, the in-app updater is hidden. This package has no control plane.
INSTANCE_SLUG=

# App root used by the optional update checker and conversion paths.
APP_DIR=/opt/prompt-a-thon
CONVERSION_DIR=/opt/prompt-a-thon/conversion

# Trust Cloudflare visitor headers. Leave false unless Cloudflare is the proxy.
TRUST_CLOUDFLARE=false

# Optional HTTPS manifest URL. Empty disables update checks. The app never downloads release files. See docs/updates.md.
UPDATE_MANIFEST_URL=

# =====================================================================
# Mail delivery
# Pick exactly one of "smtp", "brevo_api", "ses_api", or "postfix".
# =====================================================================
MAIL_PROVIDER=smtp

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=prompt-a-thon

# ---------- SMTP (used when MAIL_PROVIDER=smtp) ----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=apikey-or-username
SMTP_PASSWORD=your-smtp-key-not-account-password
SMTP_FROM_NAME=prompt-a-thon
# true for ports 587/2525 (STARTTLS); false for port 465 (implicit SSL).
SMTP_USE_TLS=true

# ---------- Brevo HTTPS API (used when MAIL_PROVIDER=brevo_api) ----------
BREVO_API_KEY=

# ---------- Amazon SES API (used when MAIL_PROVIDER=ses_api) ----------
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=us-east-1

# ---------- One-time passwords ----------
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=5

# ---------- Microsoft SSO (optional) ----------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---------- Uploads ----------
UPLOAD_FOLDER=/opt/prompt-a-thon/uploads
MAX_UPLOAD_MB=25

# ---------- Timeline (display-only fallbacks; admin overrides in DB) ----------
TIMELINE_REGISTRATION_OPEN=
TIMELINE_REGISTRATION_CLOSE=
TIMELINE_EVENT_DAY=
TIMELINE_SUBMISSION_DEADLINE=
TIMELINE_RESULTS=

# ---------- Rate limiting ----------
RATELIMIT_STORAGE_URI=memory://

# ---------- Audit retention ----------
AUDIT_LOG_RETENTION_DAYS=365
